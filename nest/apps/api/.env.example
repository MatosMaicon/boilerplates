# ─────────────────────────────────────────────────────────────
# API — copie para .env e preencha.
# Validado por Zod no boot (src/config/env.schema.ts): faltando
# uma variável obrigatória, o processo não sobe (fail-fast).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# Banco. O docker-compose local sobe o Postgres na porta 5433 do host
# (5432 costuma já estar ocupada por uma instalação nativa).
DATABASE_URL=postgres://boilerplate:boilerplate@localhost:5433/boilerplate
# Conexão direta, sem pooler, usada pelas migrations. Só é necessária em
# provedores gerenciados que separam as duas (Neon, Supabase…).
DIRECT_URL=

# Better Auth — o auth server roda DENTRO desta API (ADR 0006).
BETTER_AUTH_SECRET=     # OBRIGATÓRIO, mín. 32 chars — gere: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000    # URL pública da própria API
WEB_ORIGIN=http://localhost:3001         # origem do frontend (CORS + trustedOrigins)

# ─────────────────────────────────────────────────────────────
# Integrações entram aqui conforme o projeto precisar. Declare cada
# uma em src/config/env.schema.ts na mesma hora — variável que existe
# só no .env não é validada e falha tarde.
# ─────────────────────────────────────────────────────────────
